<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".UrWalletApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UrWallet">

        <!-- Splash: LAUNCHER, reads onboarding state and routes -->
        <activity
            android:name=".features.onboarding.presentation.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.UrWallet.Splash"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding: 3-slide value proposition -->
        <activity
            android:name=".features.onboarding.presentation.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.UrWallet"
            android:launchMode="singleTop"
            android:noHistory="true" />

        <!-- Wizard: 5-step Smart Savings Wizard -->
        <activity
            android:name=".features.onboarding.presentation.wizard.WizardActivity"
            android:exported="false"
            android:theme="@style/Theme.UrWallet"
            android:windowSoftInputMode="adjustResize"
            android:noHistory="true" />

        <!-- Main app shell (tabs) -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.UrWallet"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
