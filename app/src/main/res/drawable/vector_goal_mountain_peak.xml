    <!-- Mountain Left Base Shadow -->
    <path
        android:fillColor="#0077B6"
        android:pathData="M 0,90 L 50,32 L 30,90 Z" />

    <!-- Mountain Left-Center Vibrant Cyan Slope -->
    <path
        android:fillColor="#00B4D8"
