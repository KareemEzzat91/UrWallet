<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/urwallet_background"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/urwallet_card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:baselineAligned="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- Leading Contribution Squircle Badge -->
        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_pill_income">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_trending_up"
                app:tint="@color/urwallet_income" />
        </FrameLayout>

        <!-- Middle: Date & Note -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvContributionDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cairo"
                android:textColor="@color/urwallet_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="15 أغسطس 2026 • 02:30 م" />

            <TextView
                android:id="@+id/tvContributionNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/cairo"
                android:textColor="@color/urwallet_text_secondary"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="إيداع من المكافأة"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Trailing: Amount -->
        <TextView
            android:id="@+id/tvContributionAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cairo"
            android:textColor="@color/urwallet_income"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="+500 ج.م" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
