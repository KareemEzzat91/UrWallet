<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_surface_rounded"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/ic_drag_handle" />

    <!-- Sheet Title -->
    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/cairo"
        android:text="@string/action_add_obligation"
        android:textColor="@color/urwallet_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Direction Selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/cairo"
        android:text="@string/obligation_direction_label"
        android:textColor="@color/urwallet_text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cgDirection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:selectionRequired="true"
        app:singleLine="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipOwedToMe"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:fontFamily="@font/cairo"
            android:text="@string/obligation_owed_to_me"
            android:textSize="13sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipIOwe"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cairo"
            android:text="@string/obligation_i_owe"
            android:textSize="13sp" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Obligation Title Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilObligationTitle"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="@string/obligation_title_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:importantForAutofill="no"
            android:id="@+id/etObligationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cairo"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/urwallet_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Amount Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilObligationAmount"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/obligation_amount_hint"
        app:suffixText="@string/currency_symbol">

        <com.google.android.material.textfield.TextInputEditText
            android:importantForAutofill="no"
            android:id="@+id/etObligationAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cairo"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:textColor="@color/urwallet_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Due Date Selection -->
    <LinearLayout
        android:baselineAligned="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSelectedDueDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/cairo"
            android:text="@string/date_due_not_set"
            android:textColor="@color/urwallet_text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickDueDate"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:fontFamily="@font/cairo"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/action_set_date"
            android:textSize="12sp"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_calendar"
            app:iconGravity="textStart" />
    </LinearLayout>

    <!-- Notes Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilObligationNotes"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/person_notes_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:importantForAutofill="no"
            android:id="@+id/etObligationNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cairo"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:textColor="@color/urwallet_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Save Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveObligation"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/cairo"
        android:text="@string/action_save"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="14dp" />
</LinearLayout>
