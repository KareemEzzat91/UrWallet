<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCompletedGoal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/urwallet_background"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:strokeColor="#3310B981"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Icon squircle with checkmark, Goal info, 100% Badge & Chevron -->
        <LinearLayout
            android:baselineAligned="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Squircle Icon with Small Checkmark Overlay -->
            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="50dp">

                <FrameLayout
                    android:id="@+id/flGoalIconContainer"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_squircle_pastel_green">

                    <ImageView
                        android:id="@+id/ivGoalIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/urwallet_income" />
                </FrameLayout>

                <!-- Small Green Checkmark Badge on the corner -->
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_badge_category"
                    android:backgroundTint="@color/urwallet_surface"
                    android:contentDescription="@null"
                    android:padding="1dp"
                    android:src="@drawable/ic_check_circle_green" />
            </FrameLayout>

            <!-- Goal Information -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGoalName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/urwallet_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="سفر وسياحة" />

                <TextView
                    android:id="@+id/tvAchievedAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/urwallet_income"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="تم توفير 10,000 ج.م بالكامل 🎉" />
            </LinearLayout>

            <!-- 100% Completed Badge & Chevron -->
            <LinearLayout
                android:baselineAligned="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_income"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/goals_completed_badge"
                    android:textColor="@color/urwallet_income"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/urwallet_text_tertiary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Celebratory 100% Full Progress Bar -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:progress="100"
            app:indicatorColor="@color/urwallet_income"
            app:trackColor="#D1FAE5"
            app:trackCornerRadius="3dp"
            app:trackThickness="5dp" />

        <!-- Celebratory Trophy Note -->
        <LinearLayout
            android:baselineAligned="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_trophy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/goal_completed_badge_banner"
                android:textColor="@color/urwallet_text_tertiary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
