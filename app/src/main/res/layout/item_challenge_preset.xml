<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/urwallet_background"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/urwallet_card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Title + Duration Chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPresetTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/urwallet_text_primary"
                android:textSize="15.5sp"
                android:textStyle="bold"
                tools:text="أسبوع بلا كافيهات ومطاعم ☕" />

            <TextView
                android:id="@+id/chipDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_squircle_pastel_blue"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#0284C7"
                android:textSize="11.5sp"
                android:textStyle="bold"
                tools:text="7 أيام" />
        </LinearLayout>

        <!-- Preset Description -->
        <TextView
            android:id="@+id/tvPresetDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/urwallet_text_secondary"
            android:textSize="12.5sp"
            tools:text="امتنع عن نفقات المطاعم والمقاهي لمدة 7 أيام متتالية واصنع قهوتك ووجباتك بنفسك." />

        <!-- Bottom Action & Difficulty Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_streak"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#E65100"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="متوسط" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnJoinPreset"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="@color/urwallet_primary"
                android:paddingHorizontal="16dp"
                android:text="@string/btn_join_challenge"
                android:textColor="@color/white"
                android:textSize="12.5sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="14dp"
                app:iconTint="@color/white" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
