<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/urwallet_background"
    android:paddingHorizontal="24dp"
    android:paddingTop="36dp"
    android:paddingBottom="24dp">

    <!-- App / Security Header -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/keypadContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.3">

        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_squircle_primary_light">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_lock"
                app:tint="@color/urwallet_primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvLockTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/security_lock_screen_title"
            android:textColor="@color/urwallet_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLockSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/security_lock_screen_subtitle"
            android:textColor="@color/urwallet_text_secondary"
            android:textSize="14sp" />

        <!-- 4 PIN Dots Indicator -->
        <LinearLayout
            android:baselineAligned="false"
            android:id="@+id/pinDotsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_pin_dot_empty" />

            <View
                android:id="@+id/dot2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_pin_dot_empty" />

            <View
                android:id="@+id/dot3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_pin_dot_empty" />

            <View
                android:id="@+id/dot4"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_pin_dot_empty" />
        </LinearLayout>

        <!-- Lockout / Error Message Banner -->
        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:textColor="@color/urwallet_expense"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="رمز PIN غير صحيح. حاول مرة أخرى"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- Custom Numeric Keypad -->
    <LinearLayout
        android:id="@+id/keypadContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Row 1: 1, 2, 3 -->
        <LinearLayout
            android:baselineAligned="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn1"
                style="@style/UrWalletKeypadButton"
                android:text="1" />

            <TextView
                android:id="@+id/btn2"
                style="@style/UrWalletKeypadButton"
                android:text="2" />

            <TextView
                android:id="@+id/btn3"
                style="@style/UrWalletKeypadButton"
                android:text="3" />
        </LinearLayout>

        <!-- Row 2: 4, 5, 6 -->
        <LinearLayout
            android:baselineAligned="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn4"
                style="@style/UrWalletKeypadButton"
                android:text="4" />

            <TextView
                android:id="@+id/btn5"
                style="@style/UrWalletKeypadButton"
                android:text="5" />

            <TextView
                android:id="@+id/btn6"
                style="@style/UrWalletKeypadButton"
                android:text="6" />
        </LinearLayout>

        <!-- Row 3: 7, 8, 9 -->
        <LinearLayout
            android:baselineAligned="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn7"
                style="@style/UrWalletKeypadButton"
                android:text="7" />

            <TextView
                android:id="@+id/btn8"
                style="@style/UrWalletKeypadButton"
                android:text="8" />

            <TextView
                android:id="@+id/btn9"
                style="@style/UrWalletKeypadButton"
                android:text="9" />
        </LinearLayout>

        <!-- Row 4: Biometric, 0, Delete -->
        <LinearLayout
            android:baselineAligned="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btnBiometric"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_keypad_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/security_biometric_title"
                    android:src="@drawable/ic_fingerprint"
                    app:tint="@color/urwallet_primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/btn0"
                style="@style/UrWalletKeypadButton"
                android:text="0" />

            <FrameLayout
                android:id="@+id/btnDelete"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_keypad_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/security_keypad_delete"
                    android:src="@drawable/ic_backspace"
                    app:tint="@color/urwallet_text_primary" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
