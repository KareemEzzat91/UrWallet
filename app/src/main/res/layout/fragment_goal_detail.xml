<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/urwallet_background"
    android:layoutDirection="rtl">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/screen_padding_top"
            android:paddingBottom="100dp">

            <!-- Top Toolbar Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <!-- Back Button Squircle -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    app:cardBackgroundColor="@color/urwallet_background"
                    app:cardCornerRadius="13dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/urwallet_card_border"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:id="@+id/btnBack"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:contentDescription="@string/cd_back"
                        android:focusable="true"
                        android:padding="9dp"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/urwallet_text_primary" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Screen Title -->
                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/cairo"
                    android:text="@string/title_goal_detail"
                    android:textColor="@color/urwallet_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Delete Goal Button Squircle -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:cardBackgroundColor="@color/urwallet_background"
                    app:cardCornerRadius="13dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/urwallet_card_border"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:id="@+id/btnDeleteGoal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:contentDescription="@string/action_delete"
                        android:focusable="true"
                        android:padding="10dp"
                        android:src="@drawable/ic_delete"
                        app:tint="@color/urwallet_expense" />
                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/progressLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="60dp"
                android:indeterminateTint="@color/urwallet_primary"
                android:visibility="gone" />

            <!-- Main Detail Content -->
            <LinearLayout
                android:id="@+id/layoutGoalDetailContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Hero Progress Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/urwallet_background"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/urwallet_card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <!-- Icon Container Squircle -->
                        <FrameLayout
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:background="@drawable/bg_squircle_primary_light">

                            <ImageView
                                android:id="@+id/ivGoalDetailIcon"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_nav_goals_filled"
                                app:tint="@color/urwallet_primary" />
                        </FrameLayout>

                        <!-- Goal Name -->
                        <TextView
                            android:id="@+id/tvGoalDetailName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/cairo"
                            android:gravity="center"
                            android:textColor="@color/urwallet_text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="شراء سيارة جديدة" />

                        <!-- Large Radial Progress Ring -->
                        <FrameLayout
                            android:layout_width="140dp"
                            android:layout_height="140dp"
                            android:layout_marginTop="20dp">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/detailProgressIndicator"
                                android:layout_width="140dp"
                                android:layout_height="140dp"
                                android:layout_gravity="center"
                                app:indicatorColor="@color/urwallet_primary"
                                app:indicatorSize="140dp"
                                app:trackColor="@color/urwallet_primary_light"
                                app:trackCornerRadius="6dp"
                                app:trackThickness="11dp"
                                tools:progress="65" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvDetailProgressPercentage"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/cairo"
                                    android:textColor="@color/urwallet_primary"
                                    android:textSize="26sp"
                                    android:textStyle="bold"
                                    tools:text="65%" />

                                <TextView
                                    android:id="@+id/tvDetailStatusBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:background="@drawable/bg_pill_primary"
                                    android:fontFamily="@font/cairo"
                                    android:paddingHorizontal="12dp"
                                    android:paddingVertical="3dp"
                                    android:text="@string/status_active"
                                    android:textColor="@color/urwallet_primary"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </FrameLayout>

                        <!-- 3-Box Financial Matrix -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:orientation="horizontal">

                            <!-- Saved Box -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_stat_box_green"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/cairo"
                                    android:text="@string/goals_saved_prefix"
                                    android:textColor="@color/urwallet_income"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvDetailSavedAmount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/cairo"
                                    android:maxLines="1"
                                    android:textColor="@color/urwallet_income"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="13,000 ج.م" />
                            </LinearLayout>

                            <!-- Remaining Box -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="2dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_stat_box_gray"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/cairo"
                                    android:text="@string/goals_remaining_label"
                                    android:textColor="@color/urwallet_text_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvDetailRemainingAmount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/cairo"
                                    android:maxLines="1"
                                    android:textColor="@color/urwallet_text_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="7,000 ج.م" />
                            </LinearLayout>

                            <!-- Target Box -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_stat_box_navy"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/cairo"
                                    android:text="@string/goals_target_label"
                                    android:textColor="@color/urwallet_primary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvDetailTargetAmount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/cairo"
                                    android:maxLines="1"
                                    android:textColor="@color/urwallet_text_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="20,000 ج.م" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Primary CTA: Contribute -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnContributeAction"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="22dp"
                            android:fontFamily="@font/cairo"
                            android:text="@string/action_contribute_full"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/urwallet_primary"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_add"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp"
                            app:iconTint="@color/white" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Plan & Timeline Metrics Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <!-- Required Monthly Savings -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/urwallet_background"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:strokeColor="@color/urwallet_card_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <FrameLayout
                                    android:layout_width="34dp"
                                    android:layout_height="34dp"
                                    android:background="@drawable/bg_squircle_pastel_blue">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_calendar"
                                        app:tint="@color/urwallet_primary" />
                                </FrameLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:fontFamily="@font/cairo"
                                    android:text="@string/goal_monthly_target_label"
                                    android:textColor="@color/urwallet_text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvRequiredMonthlySavings"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/cairo"
                                android:textColor="@color/urwallet_primary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="1,166 ج.م" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Days Remaining -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/urwallet_background"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:strokeColor="@color/urwallet_card_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <FrameLayout
                                    android:layout_width="34dp"
                                    android:layout_height="34dp"
                                    android:background="@drawable/bg_squircle_pastel_amber">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_clock"
                                        app:tint="#D97706" />
                                </FrameLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:fontFamily="@font/cairo"
                                    android:text="@string/goal_days_remaining_label"
                                    android:textColor="@color/urwallet_text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvDetailDaysRemaining"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/cairo"
                                android:textColor="@color/urwallet_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="180 يوم" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Contribution History Section Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_squircle_pastel_green">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_trending_up"
                            app:tint="@color/urwallet_income" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/cairo"
                        android:text="@string/contributions_history_title"
                        android:textColor="@color/urwallet_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Empty Contributions State -->
                <TextView
                    android:id="@+id/tvEmptyContributions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="12dp"
                    android:background="@drawable/bg_stat_box_gray"
                    android:fontFamily="@font/cairo"
                    android:gravity="center"
                    android:paddingVertical="20dp"
                    android:paddingHorizontal="16dp"
                    android:text="@string/contributions_empty"
                    android:textColor="@color/urwallet_text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Contributions RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvContributions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_goal_contribution" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
