<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/urwallet_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/screen_padding_top"
            android:paddingBottom="100dp">

            <!-- Top Toolbar Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_back"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/urwallet_text_primary" />

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/title_goal_detail"
                    android:textColor="@color/urwallet_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnDeleteGoal"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_delete"
                    android:padding="8dp"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/urwallet_expense" />
            </LinearLayout>

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/progressLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="60dp"
                android:indeterminateTint="@color/urwallet_primary"
                android:visibility="gone" />

            <!-- Main Detail Content -->
            <LinearLayout
                android:id="@+id/layoutGoalDetailContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Hero Progress Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/urwallet_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/urwallet_card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <!-- Icon Container -->
                        <FrameLayout
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_squircle_primary_light">

                            <ImageView
                                android:id="@+id/ivGoalDetailIcon"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_nav_goals_filled"
                                app:tint="@color/urwallet_primary" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvGoalDetailName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:textColor="@color/urwallet_text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="شراء سيارة جديدة" />

                        <!-- Large Radial Progress Ring -->
                        <FrameLayout
                            android:layout_width="130dp"
                            android:layout_height="130dp"
                            android:layout_marginTop="20dp">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/detailProgressIndicator"
                                android:layout_width="130dp"
                                android:layout_height="130dp"
                                android:layout_gravity="center"
                                app:indicatorColor="@color/urwallet_primary"
                                app:indicatorSize="130dp"
                                app:trackColor="@color/urwallet_primary_light"
                                app:trackCornerRadius="5dp"
                                app:trackThickness="10dp"
                                tools:progress="65" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvDetailProgressPercentage"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/urwallet_primary"
                                    android:textSize="26sp"
                                    android:textStyle="bold"
                                    tools:text="65%" />

                                <TextView
                                    android:id="@+id/tvDetailStatusBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:background="@drawable/bg_pill_primary"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="3dp"
                                    android:text="@string/status_active"
                                    android:textColor="@color/urwallet_primary"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </FrameLayout>

                        <!-- 3-Box Financial Matrix -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:orientation="horizontal">

                            <!-- Saved Box -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_stat_box_green"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="10dp"
                                android:paddingHorizontal="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/goals_saved_prefix"
                                    android:textColor="@color/urwallet_income"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvDetailSavedAmount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textColor="@color/urwallet_income"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="13,000 ج.م" />
                            </LinearLayout>

                            <!-- Remaining Box -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="2dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_stat_box_gray"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="10dp"
                                android:paddingHorizontal="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/goals_remaining_label"
                                    android:textColor="@color/urwallet_text_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvDetailRemainingAmount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textColor="@color/urwallet_text_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="7,000 ج.م" />
                            </LinearLayout>

                            <!-- Target Box -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_stat_box_navy"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="10dp"
                                android:paddingHorizontal="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/goals_target_label"
                                    android:textColor="@color/urwallet_primary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvDetailTargetAmount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textColor="@color/urwallet_text_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="20,000 ج.م" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Primary CTA: Contribute -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnContributeAction"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="20dp"
                            android:text="@string/action_contribute_full"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/urwallet_primary"
                            app:cornerRadius="@dimen/input_corner_radius"
                            app:icon="@drawable/ic_add"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp"
                            app:iconTint="@color/white" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Plan & Timeline Metrics Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <!-- Required Monthly Savings -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/urwallet_surface"
                        app:cardCornerRadius="@dimen/card_corner_radius_medium"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/urwallet_card_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/goal_monthly_target_label"
                                android:textColor="@color/urwallet_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvRequiredMonthlySavings"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/urwallet_primary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="1,166 ج.م" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Days Remaining -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/urwallet_surface"
                        app:cardCornerRadius="@dimen/card_corner_radius_medium"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/urwallet_card_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/goal_days_remaining_label"
                                android:textColor="@color/urwallet_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvDetailDaysRemaining"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/urwallet_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="180 يوم" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Contribution History Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/contributions_history_title"
                    android:textColor="@color/urwallet_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Empty Contributions State -->
                <TextView
                    android:id="@+id/tvEmptyContributions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="16dp"
                    android:gravity="center"
                    android:text="@string/contributions_empty"
                    android:textColor="@color/urwallet_text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvContributions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_goal_contribution" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
