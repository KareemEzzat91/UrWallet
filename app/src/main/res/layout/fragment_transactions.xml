<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/urwallet_background"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/screen_padding_top">

    <!-- Top Header: Title & Subtitle (Start) + Filter Squircle Button (End) -->
    <LinearLayout
        android:id="@+id/layoutNormalHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTransactionsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_transactions"
                android:textColor="@color/urwallet_text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTransactionsSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/transactions_subtitle"
                android:textColor="@color/urwallet_text_tertiary"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- Top Right Filter Button (Squircle) -->
        <FrameLayout
            android:id="@+id/btnHeaderFilter"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_btn_filter_header"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/action_filter"
                android:src="@drawable/ic_filter"
                app:tint="@color/urwallet_primary" />
        </FrameLayout>
    </LinearLayout>

    <!-- Selection Action Bar (Visible in Multi-Selection Mode) -->
    <LinearLayout
        android:id="@+id/layoutSelectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="4dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/btnCloseSelection"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_cancel"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="@color/urwallet_text_primary" />

        <TextView
            android:id="@+id/tvSelectionCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="@color/urwallet_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="3 محدد" />

        <!-- Change Category Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBulkChangeCategory"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:paddingHorizontal="12dp"
            android:text="تغيير الفئة"
            android:textColor="@color/urwallet_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@color/urwallet_primary_light"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_other"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="16dp"
            app:iconTint="@color/urwallet_primary" />

        <!-- Bulk Delete Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBulkDelete"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingHorizontal="12dp"
            android:text="@string/action_delete"
            android:textColor="@color/urwallet_expense"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#FEE2E2"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_delete"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="16dp"
            app:iconTint="@color/urwallet_expense" />
    </LinearLayout>

    <!-- Modern Rounded Search Bar -->
    <LinearLayout
        android:id="@+id/layoutSearchBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_search_modern"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/hint_search_transactions"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/urwallet_text_primary"
            android:textColorHint="@color/urwallet_text_tertiary"
            android:textSize="13.5sp" />

        <ImageView
            android:id="@+id/ivClearSearch"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_clear_search"
            android:padding="4dp"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="@color/urwallet_text_secondary"
            tools:visibility="visible" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/cd_search_icon"
            android:src="@drawable/ic_search"
            app:tint="@color/urwallet_text_tertiary" />
    </LinearLayout>

    <!-- Quick Filters & Advanced Filter Row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Advanced Filter Button with Badge -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdvancedFilter"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:backgroundTint="#EEF2FF"
                    android:paddingHorizontal="14dp"
                    android:text="@string/action_filter"
                    android:textColor="@color/urwallet_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="20dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_filter"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/urwallet_primary"
                    app:strokeColor="#C7D2FE"
                    app:strokeWidth="1dp" />

                <!-- Active Filter Indicator Badge -->
                <View
                    android:id="@+id/viewFilterBadge"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_filter_badge"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </FrameLayout>

            <!-- Quick Type Filter Chips -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupQuickType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:checked="true"
                    android:text="@string/filter_all"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:checkedIcon="@drawable/ic_check"
                    app:checkedIconVisible="true"
                    app:chipCornerRadius="20dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipExpenses"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/filter_expenses"
                    android:textSize="13sp"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="20dp"
                    app:chipIcon="@drawable/ic_arrow_downward"
                    app:chipIconSize="16dp"
                    app:chipIconTint="@color/urwallet_expense"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipIncome"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/filter_income"
                    android:textSize="13sp"
                    app:checkedIconVisible="false"
                    app:chipCornerRadius="20dp"
                    app:chipIcon="@drawable/ic_arrow_upward"
                    app:chipIconSize="16dp"
                    app:chipIconTint="@color/urwallet_income"
                    app:chipIconVisible="true" />

            </com.google.android.material.chip.ChipGroup>

            <!-- Quick Calendar Button -->
            <FrameLayout
                android:id="@+id/btnDateFilter"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_filter_header"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/urwallet_primary" />
            </FrameLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Hero Card Banner with 3D Mascot Background -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardReportsBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/urwallet_background"
        app:cardCornerRadius="22dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/urwallet_card_border"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="120dp">

            <!-- Background WebP Illustration (0dp MATCH_CONSTRAINT) -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/trasnarctions_hero_bg"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Close/Dismiss Button (Top-Left in RTL = End + Top) -->
            <ImageView
                android:id="@+id/btnCloseReportsBanner"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_close"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#64748B" />

            <!-- Title (Top-Right in RTL = Start + Top) -->
            <TextView
                android:id="@+id/tvReportsBannerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="12dp"
                android:gravity="start"
                android:text="@string/reports_banner_title"
                android:textColor="#0A1172"
                android:textSize="15.5sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/btnCloseReportsBanner"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Subtitle (Right in RTL, below Title) -->
            <TextView
                android:id="@+id/tvReportsBannerDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="16dp"
                android:gravity="start"
                android:lineSpacingExtra="2dp"
                android:text="@string/reports_banner_desc"
                android:textColor="#475569"
                android:textSize="11.5sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnViewReports"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvReportsBannerTitle"
                app:layout_constraintVertical_bias="0.0" />

            <!-- Action Button: Bottom-Left in RTL = End + Bottom -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewReports"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="14dp"
                android:backgroundTint="#000666"
                android:paddingHorizontal="14dp"
                android:paddingVertical="0dp"
                android:text="@string/action_view_reports"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="19dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_chart_bars"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="14dp"
                app:iconTint="@color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnCloseReportsBanner"
                app:layout_constraintVertical_bias="1.0" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- FrameLayout for states -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <!-- Skeleton Loading State -->
        <LinearLayout
            android:id="@+id/layoutSkeletonTransactions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <include layout="@layout/layout_skeleton_transaction_item" />
            <include layout="@layout/layout_skeleton_transaction_item" />
            <include layout="@layout/layout_skeleton_transaction_item" />
            <include layout="@layout/layout_skeleton_transaction_item" />
            <include layout="@layout/layout_skeleton_transaction_item" />
        </LinearLayout>

        <!-- Loading Indicator (Fallback) -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Transactions RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTransactions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="100dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_transaction" />

        <!-- Empty State 1: No Transactions in DB -->
        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_transactions"
                app:tint="@color/urwallet_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/empty_transactions_title"
                android:textColor="@color/urwallet_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/empty_transactions_desc"
                android:textColor="@color/urwallet_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyAddTransaction"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/urwallet_primary"
                android:text="@string/action_add_transaction"
                android:textColor="@color/white"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconTint="@color/white" />
        </LinearLayout>

        <!-- Empty State 2: No Search/Filter Results -->
        <LinearLayout
            android:id="@+id/layoutNoSearchResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="@color/urwallet_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/search_no_results_title"
                android:textColor="@color/urwallet_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/search_no_results_desc"
                android:textColor="@color/urwallet_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetFilters"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/action_reset_filters"
                android:textColor="@color/urwallet_primary"
                app:cornerRadius="12dp"
                app:strokeColor="@color/urwallet_primary" />
        </LinearLayout>

        <!-- Error State -->
        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="@color/urwallet_expense"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="حدث خطأ في تحميل البيانات" />

    </FrameLayout>

</LinearLayout>
