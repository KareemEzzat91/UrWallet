<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@color/urwallet_background"
    tools:context=".MainActivity">

    <!-- NavHost Fragment Container -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHostFragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_main" />

    <!-- Material 3 Elevated Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="8dp"
        app:itemActiveIndicatorStyle="@style/Widget.UrWallet.BottomNavigationView.ActiveIndicator"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/nav_item_color_state"
        app:itemPaddingBottom="8dp"
        app:itemPaddingTop="8dp"
        app:itemTextAppearanceActive="@style/TextAppearance.UrWallet.BottomNav.Active"
        app:itemTextAppearanceInactive="@style/TextAppearance.UrWallet.BottomNav.Inactive"
        app:itemTextColor="@color/nav_item_color_state"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

    <!-- Global FAB (+ Add Transaction) Center Docked -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:contentDescription="@string/fab_add_transaction"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/urwallet_accent"
        app:elevation="16dp"
        app:fabCustomSize="56dp"
        app:maxImageSize="28dp"
        app:rippleColor="@color/white"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.UrWallet.Pill"
        app:tint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>