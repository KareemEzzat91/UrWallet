<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/urwallet_background"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="20dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/urwallet_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/title_transaction_detail"
            android:textColor="@color/urwallet_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Loading Indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Detail Content -->
        <ScrollView
            android:id="@+id/scrollDetailContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="16dp">

                <!-- Hero Section: Icon + Title + Amount + Type Pill -->
                <FrameLayout
                    android:id="@+id/flCategoryIconBadge"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_icon_circle">

                    <ImageView
                        android:id="@+id/ivCategoryIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_food"
                        app:tint="@color/urwallet_primary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvTransactionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/urwallet_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="ستاربكس" />

                <TextView
                    android:id="@+id/tvTransactionAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/urwallet_expense"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    tools:text="- 320.00 ج.م" />

                <TextView
                    android:id="@+id/tvTransactionTypeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_pill_primary"
                    android:backgroundTint="#FEE2E2"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/urwallet_expense"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="مصروف" />

                <!-- Details Table Card (Figma Node 2021:449) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    app:cardBackgroundColor="@color/urwallet_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/urwallet_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Category Row -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:text="@string/detail_category_label"
                                android:textColor="@color/urwallet_text_secondary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvCategoryName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:textColor="@color/urwallet_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="أكل" />
                        </RelativeLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="14dp"
                            android:background="@color/urwallet_divider" />

                        <!-- Date & Time Row -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:text="@string/detail_date_label"
                                android:textColor="@color/urwallet_text_secondary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvDateTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:textColor="@color/urwallet_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="21 مايو 2026 • 10:45 م" />
                        </RelativeLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="14dp"
                            android:background="@color/urwallet_divider" />

                        <!-- Note Row -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:text="@string/detail_note_label"
                                android:textColor="@color/urwallet_text_secondary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvNote"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:maxWidth="200dp"
                                android:textColor="@color/urwallet_text_primary"
                                android:textSize="14sp"
                                tools:text="قهوة مع الأصدقاء" />
                        </RelativeLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Action Buttons: Share & Delete -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShare"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="@string/action_share"
                        android:textColor="@color/urwallet_primary"
                        android:textSize="15sp"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_share"
                        app:iconGravity="textStart"
                        app:iconTint="@color/urwallet_primary"
                        app:strokeColor="@color/urwallet_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDelete"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/urwallet_expense"
                        android:text="@string/action_delete"
                        android:textColor="@color/urwallet_surface"
                        android:textSize="15sp"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_delete"
                        app:iconGravity="textStart"
                        app:iconTint="@color/urwallet_surface" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Error State -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="24dp"
            android:textColor="@color/urwallet_expense"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="حدث خطأ أثناء تحميل المعاملة" />

    </FrameLayout>
</LinearLayout>
