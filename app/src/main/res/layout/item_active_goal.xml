<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardGoal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/urwallet_background"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/urwallet_card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Row: Category Squircle, Name & Days Remaining, and Pace Pill -->
        <LinearLayout
            android:baselineAligned="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Category Pastel Squircle Icon Container (Start in RTL) -->
            <FrameLayout
                android:id="@+id/flGoalIconContainer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_squircle_pastel_amber">

                <ImageView
                    android:id="@+id/ivGoalIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/urwallet_warning" />
            </FrameLayout>

            <!-- Goal Name & Days Remaining -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGoalName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/urwallet_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="صندوق الطوارئ" />

                <LinearLayout
                    android:baselineAligned="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDaysRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        tools:text="متبقي 363 يوم" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_calendar"
                        app:tint="#64748B" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pace Badge (End in RTL, without chevron) -->
            <TextView
                android:id="@+id/tvPaceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_pace_green"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:textColor="#00732C"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="● وتيرة متوازنة" />
        </LinearLayout>

        <!-- Middle Section: Financial Numbers (Start) & 64dp Circular Progress Ring (End) -->
        <LinearLayout
            android:baselineAligned="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/goals_current_amount_label"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvSavedAndTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/urwallet_text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="0 ج.م" />

                <TextView
                    android:id="@+id/tvTargetSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    tools:text="من 5,000 ج.م" />
            </LinearLayout>

            <!-- Prominent Circular Progress Ring (64dp) -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressIndicatorCircular"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    app:indicatorColor="@color/urwallet_accent"
                    app:indicatorSize="64dp"
                    app:trackColor="#E2E8F0"
                    app:trackCornerRadius="3dp"
                    app:trackThickness="6dp"
                    tools:progress="0" />

                <TextView
                    android:id="@+id/tvProgressPercentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/urwallet_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="0%" />
            </FrameLayout>
        </LinearLayout>

        <!-- Linear Progress Bar -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:indicatorColor="@color/urwallet_accent"
            app:trackColor="#EEF2F6"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp"
            tools:progress="0" />

        <!-- Bottom Action Row: Remaining Box (Start) & Deposit Button (End) -->
        <LinearLayout
            android:baselineAligned="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Rounded Remaining Stat Box (Start in RTL) -->
            <LinearLayout
                android:baselineAligned="false"
                android:id="@+id/layoutRemainingBox"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.1"
                android:background="@drawable/bg_box_remaining"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/goals_remaining_label"
                        android:textColor="#64748B"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvRemainingAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/urwallet_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="5,000 ج.م" />

                    <TextView
                        android:id="@+id/tvMonthlyNeeded"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="مطلوب 417 ج.م شهرياً" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnGoalDetailChevron"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="#64748B" />
            </LinearLayout>

            <!-- Primary Cyan Deposit Button (End in RTL) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickContribute"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="0.9"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="@string/action_contribute"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/urwallet_accent"
                app:cornerRadius="16dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                app:iconTint="@color/white" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>