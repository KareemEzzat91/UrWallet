<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardGoal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/urwallet_surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/urwallet_card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Icon, Name & Deadline, Days Left -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_squircle_primary_light">

                <ImageView
                    android:id="@+id/ivGoalIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_goals_filled"
                    app:tint="@color/urwallet_primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGoalName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/urwallet_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="صندوق الطوارئ" />

                <TextView
                    android:id="@+id/tvDeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/urwallet_text_secondary"
                    android:textSize="12sp"
                    tools:text="الموعد: 15 أكتوبر 2026" />
            </LinearLayout>

            <!-- Days Remaining Badge -->
            <TextView
                android:id="@+id/tvDaysRemaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_primary"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/urwallet_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="متبقي 45 يوم" />
        </LinearLayout>

        <!-- Subtle Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/urwallet_divider" />

        <!-- Progress & Financial Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Radial Progress Ring -->
            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="54dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressIndicator"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="center"
                    app:indicatorColor="@color/urwallet_primary"
                    app:indicatorSize="54dp"
                    app:trackColor="@color/urwallet_primary_light"
                    app:trackCornerRadius="3dp"
                    app:trackThickness="6dp"
                    tools:progress="65" />

                <TextView
                    android:id="@+id/tvProgressPercentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/urwallet_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="65%" />
            </FrameLayout>

            <!-- Financial Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSavedAndTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/urwallet_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="3,250 / 5,000 ج.م" />

                <TextView
                    android:id="@+id/tvRemainingAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/urwallet_text_secondary"
                    android:textSize="12sp"
                    tools:text="المتبقي: 1,750 ج.م" />
            </LinearLayout>

            <!-- Quick Deposit Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickContribute"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="0dp"
                android:text="@string/action_contribute"
                android:textColor="@color/urwallet_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/urwallet_primary_light"
                app:cornerRadius="@dimen/chip_corner_radius"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                app:iconTint="@color/urwallet_primary" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
