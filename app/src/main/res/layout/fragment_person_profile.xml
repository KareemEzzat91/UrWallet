<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/urwallet_background"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="20dp">

        <!-- Back Button Squircle -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            app:cardBackgroundColor="@color/urwallet_background"
            app:cardCornerRadius="13dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/urwallet_card_border"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/action_back"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/urwallet_text_primary" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/cairo"
            android:text="@string/person_profile_title"
            android:textColor="@color/urwallet_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Actions: Edit & Delete -->
        <LinearLayout
            android:baselineAligned="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/urwallet_background"
                app:cardCornerRadius="11dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/urwallet_card_border"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/btnEditPerson"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:contentDescription="@string/action_edit"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/urwallet_text_primary" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="38dp"
                android:layout_height="38dp"
                app:cardBackgroundColor="@color/urwallet_background"
                app:cardCornerRadius="11dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/urwallet_card_border"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/btnDeletePerson"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:contentDescription="@string/action_delete"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/urwallet_expense" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </RelativeLayout>

    <!-- Main Scrollable Body -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- Profile Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/urwallet_background"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/urwallet_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Person Header Row -->
                    <LinearLayout
                        android:baselineAligned="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_squircle_primary_light">

                            <TextView
                                android:id="@+id/tvProfileAvatarInitial"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/cairo"
                                android:textColor="@color/urwallet_primary"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                tools:text="أ" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvProfilePersonName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/cairo"
                                android:textColor="@color/urwallet_text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="أحمد محمود" />

                            <TextView
                                android:id="@+id/tvProfileSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/cairo"
                                android:textColor="@color/urwallet_text_secondary"
                                android:textSize="13sp"
                                tools:text="صديق • 01012345678" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Notes if present -->
                    <TextView
                        android:id="@+id/tvProfileNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/cairo"
                        android:textColor="@color/urwallet_text_secondary"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="ملاحظات: زميل العمل في المشروع"
                        tools:visibility="visible" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="@color/urwallet_card_border" />

                    <!-- Financial Summary Breakdown -->
                    <!-- Section 1: Debts / Obligations -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/cairo"
                        android:text="@string/person_debts_status"
                        android:textColor="@color/urwallet_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/cairo"
                                android:text="@string/badge_debt_owed_to_me"
                                android:textColor="@color/urwallet_income"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvProfileOwedToMe"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/cairo"
                                android:textColor="@color/urwallet_income"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="500 ج.م" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/cairo"
                                android:text="@string/badge_debt_i_owe"
                                android:textColor="@color/urwallet_expense"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvProfileIOwe"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/cairo"
                                android:textColor="@color/urwallet_expense"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="200 ج.م" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/cairo"
                                android:text="@string/net_obligation_balance_label"
                                android:textColor="@color/urwallet_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvProfileNetDebt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/cairo"
                                android:textColor="@color/urwallet_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="+300 ج.م" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Section 2: Lifetime Transaction Flow -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/cairo"
                        android:text="@string/person_actual_cashflow"
                        android:textColor="@color/urwallet_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/cairo"
                                android:text="@string/person_paid_to_him"
                                android:textColor="@color/urwallet_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvProfileTotalPaid"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/cairo"
                                android:textColor="@color/urwallet_expense"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="1,200 ج.م" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/cairo"
                                android:text="@string/person_received_from_him"
                                android:textColor="@color/urwallet_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvProfileTotalReceived"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/cairo"
                                android:textColor="@color/urwallet_income"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="800 ج.م" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/cairo"
                                android:text="@string/person_net_flow"
                                android:textColor="@color/urwallet_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvProfileNetFlow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/cairo"
                                android:textColor="@color/urwallet_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="-400 ج.م" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Add Obligation Action Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddObligation"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/cairo"
                        android:text="@string/action_add_obligation"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_add"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Filter Chips: Obligations vs Transactions -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgProfileTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipObligations"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:fontFamily="@font/cairo"
                    android:text="@string/tab_obligations"
                    android:textSize="13sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTransactions"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/cairo"
                    android:text="@string/tab_person_transactions"
                    android:textSize="13sp" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Obligations RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProfileObligations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_obligation" />

            <!-- Transactions RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProfileTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"
                tools:itemCount="3"
                tools:listitem="@layout/item_transaction" />

            <!-- Empty State for Obligations -->
            <LinearLayout
                android:id="@+id/layoutEmptyProfileObligations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone"
                tools:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/urwallet_income" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/cairo"
                    android:text="@string/empty_obligations_title"
                    android:textColor="@color/urwallet_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/cairo"
                    android:gravity="center"
                    android:text="@string/empty_obligations_desc"
                    android:textColor="@color/urwallet_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Empty State for Transactions -->
            <LinearLayout
                android:id="@+id/layoutEmptyProfileTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone"
                tools:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_transactions"
                    app:tint="@color/urwallet_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/cairo"
                    android:text="@string/empty_person_transactions_title"
                    android:textColor="@color/urwallet_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/cairo"
                    android:gravity="center"
                    android:text="@string/empty_person_transactions_desc"
                    android:textColor="@color/urwallet_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
