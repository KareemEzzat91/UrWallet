<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardTransaction"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/urwallet_background"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/urwallet_card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:baselineAligned="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Selection Checkbox (Visible in Multi-Selection Mode) -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone"
            app:buttonTint="@color/urwallet_primary"
            tools:visibility="visible" />

        <!-- 1. Right Side (Start in RTL): Category Icon Circle (48dp) -->
        <FrameLayout
            android:id="@+id/flIconContainer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_circle">

            <ImageView
                android:id="@+id/ivCategoryIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_food"
                app:tint="@color/white" />
        </FrameLayout>

        <!-- 2. Middle Section: Title & Time with Clock Icon -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTransactionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/urwallet_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="eat" />

            <LinearLayout
                android:baselineAligned="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTransactionTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    tools:text="07:52 م" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_clock"
                    app:tint="#94A3B8" />
            </LinearLayout>

            <!-- Subtitle fallback for compatibility -->
            <TextView
                android:id="@+id/tvTransactionSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 3. Left Section (End in RTL): Amount & Category Pill Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTransactionAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/urwallet_expense"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="- 200 ج.م" />

            <!-- Category Pastel Pill Badge -->
            <LinearLayout
                android:baselineAligned="false"
                android:id="@+id/flCategoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_badge_delete"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp">

                <ImageView
                    android:id="@+id/ivCategoryBadgeIcon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_food"
                    app:tint="@color/urwallet_expense" />

                <TextView
                    android:id="@+id/tvCategoryBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/urwallet_expense"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="أكل ومشروبات" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4. Delete Action Box: Soft Reddish Squircle (48dp x 48dp) -->
        <FrameLayout
            android:id="@+id/btnDelete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_badge_delete"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/action_delete"
                android:src="@drawable/ic_delete"
                app:tint="@color/urwallet_expense" />
        </FrameLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
