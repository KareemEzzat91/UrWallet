<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_surface_rounded"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/ic_drag_handle" />

    <!-- Sheet Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/cairo"
        android:text="@string/action_settle_obligation"
        android:textColor="@color/urwallet_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Obligation Summary Box -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="@color/urwallet_background"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/urwallet_card_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvSettleObligationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cairo"
                android:textColor="@color/urwallet_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="سلفة سريعة" />

            <LinearLayout
                android:baselineAligned="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSettleTotalAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/cairo"
                    android:textColor="@color/urwallet_text_secondary"
                    android:textSize="12sp"
                    tools:text="الإجمالي: 1,500 ج.م" />

                <TextView
                    android:id="@+id/tvSettleRemainingAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/cairo"
                    android:textColor="@color/urwallet_income"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="المتبقي: 600 ج.م" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Settlement Amount Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSettlementAmount"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/settlement_amount_hint"
        app:suffixText="@string/currency_symbol">

        <com.google.android.material.textfield.TextInputEditText
            android:importantForAutofill="no"
            android:id="@+id/etSettlementAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cairo"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:textColor="@color/urwallet_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Auto-create Transaction Switch -->
    <LinearLayout
        android:baselineAligned="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/cairo"
            android:text="@string/settlement_create_transaction_switch"
            android:textColor="@color/urwallet_text_primary"
            android:textSize="13sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchCreateTransaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            app:thumbTint="@color/urwallet_primary" />
    </LinearLayout>

    <!-- Notes Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSettlementNotes"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/settlement_note_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:importantForAutofill="no"
            android:id="@+id/etSettlementNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cairo"
            android:inputType="text"
            android:maxLines="2"
            android:textColor="@color/urwallet_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Confirm Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmSettlement"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/cairo"
        android:text="@string/action_confirm"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="14dp" />
</LinearLayout>
