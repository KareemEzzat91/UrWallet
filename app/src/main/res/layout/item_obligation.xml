<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/urwallet_background"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/urwallet_card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Icon + Title + Direction Badge + Total Amount -->
        <LinearLayout
            android:baselineAligned="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Direction Icon Squircle (38dp) -->
            <FrameLayout
                android:id="@+id/flDirectionBadge"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_pill_income">

                <ImageView
                    android:id="@+id/ivDirectionIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_trending_up"
                    app:tint="@color/urwallet_income" />
            </FrameLayout>

            <!-- Title & Status -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvObligationTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/cairo"
                    android:maxLines="1"
                    android:textColor="@color/urwallet_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="سلفة سريعة" />

                <TextView
                    android:id="@+id/tvDueDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/cairo"
                    android:textColor="@color/urwallet_text_secondary"
                    android:textSize="12sp"
                    tools:text="الاستحقاق: 15 أكتوبر 2026" />
            </LinearLayout>

            <!-- Amount Column -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTotalAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/cairo"
                    android:textColor="@color/urwallet_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="1,500 ج.م" />

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_pill_warning"
                    android:fontFamily="@font/cairo"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/urwallet_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="مسوى جزئياً" />
            </LinearLayout>
        </LinearLayout>

        <!-- Progress Bar -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressSettlement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:indicatorColor="@color/urwallet_primary"
            app:trackColor="@color/urwallet_card_border"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp"
            tools:progress="60" />

        <!-- Progress Text Breakdown & Settle Action -->
        <LinearLayout
            android:baselineAligned="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSettledAndRemaining"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/cairo"
                android:textColor="@color/urwallet_text_secondary"
                android:textSize="12sp"
                tools:text="تم سداد 900 ج.م • متبقي 600 ج.م" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettle"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:fontFamily="@font/cairo"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/action_settle_obligation"
                android:textSize="12sp"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <!-- Optional Notes -->
        <TextView
            android:id="@+id/tvNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/cairo"
            android:textColor="@color/urwallet_text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="ملاحظات: لحساب رحلة إسكندرية"
            tools:visibility="visible" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
