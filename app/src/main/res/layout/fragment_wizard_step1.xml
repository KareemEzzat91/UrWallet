<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wizard_step1_title"
            android:textColor="@color/urwallet_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wizard_step1_subtitle"
            android:textColor="@color/urwallet_text_secondary"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginBottom="24dp" />

        <!-- Row 1: Emergency + Travel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/card_emergency"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_goal_card_unselected"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_emergency_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_goal_emergency"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="10dp"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="@string/goal_type_emergency" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/goal_type_emergency"
                    android:textColor="@color/urwallet_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/goal_type_emergency_desc"
                    android:textColor="@color/urwallet_text_secondary"
                    android:textSize="11sp"
                    android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_travel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_goal_card_unselected"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_travel_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_goal_travel"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="10dp"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="@string/goal_type_travel" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/goal_type_travel"
                    android:textColor="@color/urwallet_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/goal_type_travel_desc"
                    android:textColor="@color/urwallet_text_secondary"
                    android:textSize="11sp"
                    android:gravity="center" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Home + Retirement -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/card_home"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_goal_card_unselected"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_home_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_goal_home"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="10dp"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="@string/goal_type_home" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/goal_type_home"
                    android:textColor="@color/urwallet_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/goal_type_home_desc"
                    android:textColor="@color/urwallet_text_secondary"
                    android:textSize="11sp"
                    android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_retirement"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_goal_card_unselected"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_retirement_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_goal_retirement"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="10dp"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="@string/goal_type_retirement" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/goal_type_retirement"
                    android:textColor="@color/urwallet_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/goal_type_retirement_desc"
                    android:textColor="@color/urwallet_text_secondary"
                    android:textSize="11sp"
                    android:gravity="center" />
            </LinearLayout>
        </LinearLayout>

        <!-- Custom goal - full width -->
        <LinearLayout
            android:id="@+id/card_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_goal_card_unselected"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iv_custom_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_goal_custom"
                android:background="@drawable/bg_icon_circle"
                android:padding="10dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="@string/goal_type_custom" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/goal_type_custom"
                    android:textColor="@color/urwallet_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/goal_type_custom_desc"
                    android:textColor="@color/urwallet_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
