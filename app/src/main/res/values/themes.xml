<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Application Material 3 Theme -->
    <style name="Theme.UrWallet" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/urwallet_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/urwallet_primary_light</item>
        <item name="colorOnPrimaryContainer">@color/urwallet_primary</item>

        <!-- Secondary & Surface Colors -->
        <item name="colorSecondary">@color/urwallet_primary_variant_start</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/urwallet_background</item>
        <item name="colorSurface">@color/urwallet_surface</item>
        <item name="colorOnSurface">@color/urwallet_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/urwallet_text_secondary</item>

        <!-- Status & Navigation Bar -->
        <item name="android:statusBarColor">@color/urwallet_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/urwallet_surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Default Shapes -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.UrWallet.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.UrWallet.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.UrWallet.Large</item>
    </style>

    <!-- Splash Screen API Theme -->
    <style name="Theme.UrWallet.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/urwallet_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.UrWallet</item>
    </style>

    <!-- Custom Shapes -->
    <style name="ShapeAppearance.UrWallet.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">@dimen/input_corner_radius</item>
    </style>

    <style name="ShapeAppearance.UrWallet.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/card_corner_radius_medium</item>
    </style>

    <style name="ShapeAppearance.UrWallet.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">@dimen/card_corner_radius</item>
    </style>

    <style name="ShapeAppearance.UrWallet.Pill" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">@dimen/chip_corner_radius</item>
    </style>

    <!-- Bottom Navigation Styles -->
    <style name="Widget.UrWallet.BottomNavigationView.ActiveIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/urwallet_primary_light</item>
        <item name="shapeAppearance">@style/ShapeAppearance.UrWallet.Pill</item>
    </style>

    <style name="TextAppearance.UrWallet.BottomNav.Active"
        parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.UrWallet.BottomNav.Inactive"
        parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>