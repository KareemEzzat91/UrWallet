<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.urwallet.features.dashboard.presentation.DashboardFragment"
        android:label="@string/nav_dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboardFragment_to_budgetsFragment"
            app:destination="@id/budgetsFragment" />
    </fragment>

    <fragment
        android:id="@+id/transactionsFragment"
        android:name="com.example.urwallet.features.transactions.presentation.TransactionsFragment"
        android:label="@string/nav_transactions"
        tools:layout="@layout/fragment_transactions">
        <action
            android:id="@+id/action_transactionsFragment_to_transactionDetailFragment"
            app:destination="@id/transactionDetailFragment" />
        <action
            android:id="@+id/action_transactionsFragment_to_categoryAnalyticsFragment"
            app:destination="@id/categoryAnalyticsFragment" />
    </fragment>

    <fragment
        android:id="@+id/transactionDetailFragment"
        android:name="com.example.urwallet.features.transactions.presentation.TransactionDetailFragment"
        android:label="@string/title_transaction_detail"
        tools:layout="@layout/fragment_transaction_detail">
        <argument
            android:name="transactionId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/categoryAnalyticsFragment"
        android:name="com.example.urwallet.features.transactions.presentation.CategoryAnalyticsFragment"
        android:label="@string/title_category_analytics"
        tools:layout="@layout/fragment_category_analytics">
        <argument
            android:name="categoryId"
            app:argType="long"
            android:defaultValue="-1L" />
        <action
            android:id="@+id/action_categoryAnalyticsFragment_to_transactionDetailFragment"
            app:destination="@id/transactionDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/goalsFragment"
        android:name="com.example.urwallet.features.goals.presentation.GoalsFragment"
        android:label="@string/nav_goals"
        tools:layout="@layout/fragment_goals">
        <action
            android:id="@+id/action_goalsFragment_to_goalDetailFragment"
            app:destination="@id/goalDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/goalDetailFragment"
        android:name="com.example.urwallet.features.goals.presentation.detail.GoalDetailFragment"
        android:label="@string/title_goal_detail"
        tools:layout="@layout/fragment_goal_detail">
        <argument
            android:name="goalId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/moreFragment"
        android:name="com.example.urwallet.features.more.presentation.MoreFragment"
        android:label="@string/nav_more"
        tools:layout="@layout/fragment_more">
        <action
            android:id="@+id/action_moreFragment_to_budgetsFragment"
            app:destination="@id/budgetsFragment" />
        <action
            android:id="@+id/action_moreFragment_to_analyticsFragment"
            app:destination="@id/analyticsFragment" />
        <action
            android:id="@+id/action_moreFragment_to_habitsFragment"
            app:destination="@id/habitsFragment" />
    </fragment>

    <fragment
        android:id="@+id/budgetsFragment"
        android:name="com.example.urwallet.features.budgets.presentation.BudgetsFragment"
        android:label="@string/nav_budgets"
        tools:layout="@layout/fragment_budgets" />

    <fragment
        android:id="@+id/analyticsFragment"
        android:name="com.example.urwallet.features.analytics.presentation.AnalyticsFragment"
        android:label="@string/analytics_title"
        tools:layout="@layout/fragment_analytics">
        <action
            android:id="@+id/action_analyticsFragment_to_habitsFragment"
            app:destination="@id/habitsFragment" />
        <action
            android:id="@+id/action_analyticsFragment_to_categoryAnalyticsFragment"
            app:destination="@id/categoryAnalyticsFragment" />
    </fragment>

    <fragment
        android:id="@+id/habitsFragment"
        android:name="com.example.urwallet.features.analytics.presentation.HabitsFragment"
        android:label="@string/habits_title"
        tools:layout="@layout/fragment_habits" />

</navigation>
